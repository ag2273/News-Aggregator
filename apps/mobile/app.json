{
  "expo": {
    "name": "أخبار",
    "slug": "news-aggregator",
    "version": "1.0.0",
    "scheme": "news-aggregator",
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.zorrotmh.newsaggregator",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#22C55E"
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "85586a9c-dd1e-4bbf-beb6-a4c4e35c92e1"
      }
    },
    "owner": "zorro_tmh"
  }
}
