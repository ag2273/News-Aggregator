+    /**
+     * The one hook that runs BEFORE the network for every sub-resource.
+     *
+     * `react-native-webview` exposes no JavaScript equivalent: the page's ad scripts
+     * and iframes are sub-resource requests, and only top-level navigations reach the
+     * `onShouldStartLoadWithRequest` callback. Blocking here means the payload is
+     * never downloaded, which is the difference the user asked for.
+     *
+     * The denylist lives on the WebView, not on this client: props are applied after
+     * the client is created, so reading it per request avoids an ordering bug where
+     * the first page load would still see an empty list.
+     */
+    @Override
+    @Nullable
+    public WebResourceResponse shouldInterceptRequest(WebView view, WebResourceRequest request) {
+        if (view instanceof RNCWebView) {
+            RNCWebViewAdBlocker blocker = ((RNCWebView) view).getAdBlocker();
+            if (blocker != null && blocker.isEnabled()) {
+                WebResourceResponse blocked = blocker.intercept(request);
+                if (blocked != null) return blocked;
+            }
+        }
+        return super.shouldInterceptRequest(view, request);
+    }
+
+    /** The pre-Lollipop overload, kept consistent for older devices. */
+    @Override
+    @Nullable
+    public WebResourceResponse shouldInterceptRequest(WebView view, String url) {
+        if (view instanceof RNCWebView) {
+            RNCWebViewAdBlocker blocker = ((RNCWebView) view).getAdBlocker();
+            if (blocker != null && blocker.isEnabled() && blocker.shouldBlock(url)) {
+                return blocker.emptyResponse();
+            }
+        }
+        return super.shouldInterceptRequest(view, url);
+    }
