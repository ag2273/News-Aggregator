diff --git a/android/src/main/java/com/reactnativecommunity/webview/RNCWebViewAdBlocker.java b/android/src/main/java/com/reactnativecommunity/webview/RNCWebViewAdBlocker.java
new file mode 100644
index 0000000000000000000000000000000000000000..49532cfd75249f8c5e71ee3fd6d5dc2eaa8556d4
--- /dev/null
+++ b/android/src/main/java/com/reactnativecommunity/webview/RNCWebViewAdBlocker.java
@@ -0,0 +1,101 @@
+package com.reactnativecommunity.webview;
+
+import android.webkit.WebResourceRequest;
+import android.webkit.WebResourceResponse;
+
+import androidx.annotation.Nullable;
+
+import java.io.ByteArrayInputStream;
+import java.util.Arrays;
+
+/**
+ * Request-level ad blocking inside the Android WebView (#55).
+ *
+ * WHY THIS HAS TO BE NATIVE
+ * -------------------------
+ * `react-native-webview` hands JavaScript only TOP-LEVEL navigations
+ * (`onShouldStartLoadWithRequest`); a page's own ad scripts and iframes are
+ * sub-resource requests that never reach that callback. Hiding their containers with
+ * CSS leaves the payload paid for and the slots still rendering, which is what the
+ * user reported on a real phone. `WebViewClient.shouldInterceptRequest` is the one
+ * hook that runs BEFORE the network, so it is the only real fix. This class is that
+ * hook; the manager enables it per-WebView so the rest of the app is untouched.
+ *
+ * WHAT IT DOES NOT DO
+ * -------------------
+ * It never touches the page's own document. Only requests whose HOST is on the
+ * denylist are answered with an empty 200; stylesheets, fonts and images from the
+ * publisher itself pass straight through, so the article still renders as designed.
+ *
+ * Matching is exact host or subdomain, never a substring, so
+ * `doubleclick.net.attacker.example` is a different host and stays loadable.
+ */
+public class RNCWebViewAdBlocker {
+
+    /**
+     * The hosts to refuse. Kept in step with `apps/mobile/lib/adBlockHosts.ts`
+     * (AD_BLOCK_HOSTS) — that module is the source of truth and the manager passes
+     * its list here at runtime, so the two cannot drift apart.
+     */
+    private final String[] hosts;
+
+    public RNCWebViewAdBlocker(@Nullable String[] hosts) {
+        this.hosts = hosts == null ? new String[0] : hosts;
+    }
+
+    public boolean isEnabled() {
+        return hosts.length > 0;
+    }
+
+    /** Is this request an ad or tracker? Exact host or a subdomain of one. */
+    public boolean shouldBlock(@Nullable String url) {
+        if (url == null || hosts.length == 0) return false;
+        String host;
+        try {
+            host = new java.net.URL(url).getHost();
+        } catch (Exception e) {
+            return false;
+        }
+        if (host == null) return false;
+        host = host.toLowerCase(java.util.Locale.ROOT);
+        for (String blocked : hosts) {
+            if (blocked == null || blocked.isEmpty()) continue;
+            String b = blocked.toLowerCase(java.util.Locale.ROOT);
+            if (host.equals(b) || host.endsWith("." + b)) return true;
+        }
+        return false;
+    }
+
+    /**
+     * The response to hand the WebView instead of making the request.
+     *
+     * An empty 200, not a network error: a failed request makes some ad scripts retry
+     * or show their own error slot, while an empty body simply renders nothing. No
+     * cache headers, so nothing is remembered across page loads.
+     */
+    public WebResourceResponse emptyResponse() {
+        WebResourceResponse response = new WebResourceResponse(
+            "text/plain", "utf-8", new ByteArrayInputStream(new byte[0]));
+        java.util.Map<String, String> headers = new java.util.HashMap<>();
+        headers.put("Cache-Control", "no-store");
+        headers.put("Access-Control-Allow-Origin", "*");
+        response.setResponseHeaders(headers);
+        return response;
+    }
+
+    /**
+     * The interception itself. Returns null to let the request proceed, which is the
+     * contract `shouldInterceptRequest` expects.
+     */
+    @Nullable
+    public WebResourceResponse intercept(@Nullable WebResourceRequest request) {
+        if (request == null) return null;
+        String url = request.getUrl() == null ? null : request.getUrl().toString();
+        return shouldBlock(url) ? emptyResponse() : null;
+    }
+
+    @Override
+    public String toString() {
+        return "RNCWebViewAdBlocker{hosts=" + Arrays.toString(hosts) + "}";
+    }
+}
